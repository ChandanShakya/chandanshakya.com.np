    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .in-view .area-wrap { opacity: 1; transform: none; }
  .area-plot {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    min-width: 0;
    overflow: hidden;
  }
  :global(.area-plot .grid line) {
    stroke: var(--border);
    stroke-width: 1;
    opacity: 0.25;
  }
  :global(.area-plot .grid text) {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  :global(.area-plot .x-label) {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
  }
  :global(.area-plot .area) { stroke: var(--border); stroke-width: 1.5; }
