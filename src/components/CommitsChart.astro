  :global(.area-plot .area-6) { fill: #db2777; }
  :global(.area-plot .area-7) { fill: #65a30d; }
  :global(.area-plot .area-8) { fill: var(--muted); fill-opacity: 0.55; }
  .y-note { margin-top: 0; }

  /* Hover tooltip (content built by client JS -> global rules) */
  :global(.chart-tip) {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--bg);
    color: var(--fg);
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.4;
    padding: 0.5rem 0.6rem;
