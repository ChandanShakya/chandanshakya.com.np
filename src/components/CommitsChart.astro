  }

  /* Stacked monthly area plot */
  /* NOTE: SVG inner nodes are rebuilt by client JS on range switch.
     Astro scopes <style> via data-astro-cid, which runtime-created
     nodes lack — so every rule matching rebuilt SVG content must be
     :global, else fills/strokes fall back to black (dark chart). */
  .area-wrap {
    position: relative;
    border: 2px solid var(--border);
    background: var(--panel);
    padding: 0.5rem;
    margin-bottom: 1rem;
