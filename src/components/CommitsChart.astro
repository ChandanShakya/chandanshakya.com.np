  .legend-swatch {
    width: 0.8rem;
    height: 0.8rem;
    background: var(--fg);
    border: 2px solid var(--border);
    flex-shrink: 0;
  }
  .legend-swatch.seg-0 { background: #2563eb; }
  .legend-swatch.seg-1 { background: #dc2626; }
  .legend-swatch.seg-2 { background: #16a34a; }
  .legend-swatch.seg-3 { background: #d97706; }
  .legend-swatch.seg-4 { background: #7c3aed; }
  .legend-swatch.seg-5 { background: #0891b2; }
  .legend-swatch.seg-6 { background: #db2777; }
