  /* Legend (both modes) */
  .chart-legend { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 100%; min-width: 0; }
  .legend-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--bg);
    color: var(--fg);
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    border-radius: 0;
    box-sizing: border-box;
