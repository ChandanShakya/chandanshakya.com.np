---
interface ChartItem {
  id: string;
  title: string;
  commits: number;
}

interface HistoryWeek {
  week: number;
  total: number;
  repos: Record<string, number>;
}

interface HistoryData {
  generatedAt: string;
  weeks: HistoryWeek[];
}

interface Props {
  projects: ChartItem[];
  history?: HistoryData | null;
  topN?: number;
}

const { projects, history = null, topN = 12 } = Astro.props;

function fmt(n: number): string {
  return n.toLocaleString('en-US');
}

// --- Snapshot fallback (per-project totals) ---
const sorted = [...projects].sort((a, b) => b.commits - a.commits);
const top = sorted.slice(0, topN);
const rest = sorted.slice(topN);
const othersCommits = rest.reduce((sum, p) => sum + p.commits, 0);
const hasOthers = rest.length > 0;

interface Bar extends ChartItem {
  isOthers?: boolean;
  count?: number;
}

const bars: Bar[] = [...top];
if (hasOthers) {
  bars.push({ id: '__others__', title: `Others (${rest.length} more)`, commits: othersCommits, isOthers: true, count: rest.length });
}

const max = Math.max(...bars.map((b) => b.commits), 1);
const total = sorted.reduce((sum, p) => sum + p.commits, 0);

// --- Over-time mode: weekly history -> 12 monthly buckets + weekly drill-down ---
const TIME_TOP = 8;
const MONTHS = 12;
const hasHistory = !!history && history.weeks.length > 0;

interface Series extends ChartItem {
  isOthers?: boolean;
  count?: number;
  monthly: number[];
  weekly: number[];
  windowTotal: number;
}

let series: Series[] = [];
let monthMax = 1;
let windowTotal = 0;
let windowProjects = 0;
let monthLabels: string[] = [];
let monthCount = 0;
let stackedPaths: string[] = [];
let weekStamps: number[] = [];
let monthOptions: { key: number; value: string; label: string }[] = [];
let lastMonthValue = '';

const W = 720;
const H = 280;
const PAD_L = 40;
const PAD_R = 10;
const PAD_T = 12;
const PAD_B = 30;
const PLOT_W = W - PAD_L - PAD_R;
const PLOT_H = H - PAD_T - PAD_B;

function f(n: number): string {
  return (Math.round(n * 10) / 10).toString();
}

function xPos(j: number, m: number): number {
  if (m <= 1) return PAD_L + PLOT_W / 2;
  return PAD_L + (PLOT_W * j) / (m - 1);
}

function yPos(v: number, peak: number): number {
  if (peak <= 0) return PAD_T + PLOT_H;
  return PAD_T + PLOT_H * (1 - v / peak);
}

// Catmull-Rom -> cubic Bezier smoothing through points
function smoothThrough(pts: { x: number; y: number }[]): string {
  if (pts.length === 0) return '';
  if (pts.length === 1) return `M ${f(pts[0].x)} ${f(pts[0].y)}`;
  if (pts.length === 2) return `M ${f(pts[0].x)} ${f(pts[0].y)} L ${f(pts[1].x)} ${f(pts[1].y)}`;
  let d = `M ${f(pts[0].x)} ${f(pts[0].y)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(0, i - 1)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(pts.length - 1, i + 2)];
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${f(c1x)} ${f(c1y)}, ${f(c2x)} ${f(c2y)}, ${f(p2.x)} ${f(p2.y)}`;
  }
  return d;
}

function stackedAreaPath(top: { x: number; y: number }[], bot: { x: number; y: number }[]): string {
  if (top.length === 0) return '';
  if (top.length === 1) {
    const t = top[0];
    const b = bot[0];
    return `M ${f(t.x)} ${f(t.y)} L ${f(b.x)} ${f(b.y)} Z`;
  }
  const topD = smoothThrough(top);
  const revBot = [...bot].reverse();
  // Build return path along bottom (reversed) with smoothing
  let d = topD + ` L ${f(revBot[0].x)} ${f(revBot[0].y)}`;
  if (revBot.length === 2) {
    d += ` L ${f(revBot[1].x)} ${f(revBot[1].y)}`;
  } else if (revBot.length > 2) {
    for (let i = 0; i < revBot.length - 1; i++) {
      const p0 = revBot[Math.max(0, i - 1)];
      const p1 = revBot[i];
      const p2 = revBot[i + 1];
      const p3 = revBot[Math.min(revBot.length - 1, i + 2)];
      const c1x = p1.x + (p2.x - p0.x) / 6;
      const c1y = p1.y + (p2.y - p0.y) / 6;
      const c2x = p2.x - (p3.x - p1.x) / 6;
      const c2y = p2.y - (p3.y - p1.y) / 6;
      d += ` C ${f(c1x)} ${f(c1y)}, ${f(c2x)} ${f(c2y)}, ${f(p2.x)} ${f(p2.y)}`;
    }
  }
  return d + ' Z';
}

function buildStackPaths(all: number[][], m: number, peak: number): string[] {
  const out: string[] = [];
  const cum = new Array(m).fill(0);
  for (const arr of all) {
    const top: { x: number; y: number }[] = [];
    const bot: { x: number; y: number }[] = [];
    for (let j = 0; j < m; j++) {
      const y0 = cum[j];
      const y1 = cum[j] + (arr[j] || 0);
      bot.push({ x: xPos(j, m), y: yPos(y0, peak) });
      top.push({ x: xPos(j, m), y: yPos(y1, peak) });
      cum[j] = y1;
    }
    out.push(stackedAreaPath(top, bot));
  }
  return out;
}

let yTicks: { v: number; y: number }[] = [];

if (hasHistory) {
  const weeks = [...history!.weeks].sort((a, b) => a.week - b.week).slice(-52);
  weekStamps = weeks.map((w) => w.week);
  const titleById = new Map(projects.map((p) => [p.id, p.title]));
  const topIds = sorted.slice(0, TIME_TOP).map((p) => p.id);
  const topSet = new Set(topIds);

  // Bucket weeks into months, keep last 12
  const buckets = new Map<number, { label: string; full: string; weekIdx: number[] }>();
  weeks.forEach((w, wi) => {
    const d = new Date(w.week * 1000);
    const key = d.getFullYear() * 12 + d.getMonth();
    const label = d.toLocaleString('en-US', { month: 'short' });
    const full = d.toLocaleString('en-US', { month: 'short', year: 'numeric' });
    const b = buckets.get(key);
    if (b) b.weekIdx.push(wi);
    else buckets.set(key, { label, full, weekIdx: [wi] });
  });
  const keys = [...buckets.keys()].sort((a, b) => a - b).slice(-MONTHS);
  monthLabels = keys.map((k) => buckets.get(k)!.label);
  monthCount = keys.length;
  monthOptions = keys.map((k) => {
    const y = Math.floor(k / 12);
    const m = (k % 12) + 1;
    return {
      key: k,
      value: `${y}-${String(m).padStart(2, '0')}`,
      label: buckets.get(k)!.full,
    };
  });
  lastMonthValue = monthOptions.length ? monthOptions[monthOptions.length - 1].value : '';

  const othersSlugs = new Set<string>();
  for (const w of weeks) {
    for (const slug of Object.keys(w.repos)) {
      if (!topSet.has(slug) && (w.repos[slug] || 0) > 0) othersSlugs.add(slug);
    }
  }

  const weeklyFor = (id: string | null): number[] =>
    weeks.map((w) => {
      if (id === null) {
        let n = 0;
        for (const slug of othersSlugs) n += w.repos[slug] || 0;
        return n;
      }
      return w.repos[id] || 0;
    });

  const monthlyFor = (id: string | null): number[] =>
    keys.map((k) => {
      let n = 0;
      for (const wi of buckets.get(k)!.weekIdx) {
        const w = weeks[wi];
        if (id === null) {
          for (const slug of othersSlugs) n += w.repos[slug] || 0;
        } else {
          n += w.repos[id] || 0;
        }
      }
      return n;
    });

  series = topIds.map((id) => {
    const monthly = monthlyFor(id);
    return {
      id,
      title: titleById.get(id) ?? id,
      commits: sorted.find((p) => p.id === id)?.commits ?? 0,
      monthly,
      weekly: weeklyFor(id),
      windowTotal: monthly.reduce((a, b) => a + b, 0),
    };
  });

  if (othersSlugs.size > 0) {
    const othersMonthly = monthlyFor(null);
    series.push({
      id: '__others__',
      title: `Others (${othersSlugs.size} more)`,
      commits: 0,
      isOthers: true,
      count: othersSlugs.size,
      monthly: othersMonthly,
      weekly: weeklyFor(null),
      windowTotal: othersMonthly.reduce((a, b) => a + b, 0),
    });
  }

  const stackedTotals = new Array(monthCount).fill(0);
  for (const s of series) s.monthly.forEach((n, j) => { stackedTotals[j] += n; });
  monthMax = Math.max(...stackedTotals, 1);
  windowTotal = series.reduce((a, s) => a + s.windowTotal, 0);
  windowProjects = series.reduce(
    (a, s) => a + (s.isOthers ? (s.count ?? 0) : s.windowTotal > 0 ? 1 : 0),
    0
  );

  stackedPaths = buildStackPaths(series.map((s) => s.monthly), monthCount, monthMax);

  const tickVals = [0, Math.ceil(monthMax / 3), Math.ceil((2 * monthMax) / 3), monthMax];
  const uniq = [...new Set(tickVals)].sort((a, b) => a - b);
  yTicks = uniq.map((v) => ({ v, y: yPos(v, monthMax) }));
}
---

<section class="commits-chart" id="commit-activity" aria-labelledby="commit-activity-heading">
  <h2 id="commit-activity-heading">Commit activity</h2>

  {hasHistory ? (
    <p class="meta" id="commits-total">
      {fmt(windowTotal)} commits in the last {monthCount} months across {fmt(windowProjects)} projects
    </p>
    <div class="range-row" role="group" aria-label="Chart range">
      <button type="button" class="range-btn" data-view="12m" aria-pressed="true">Last 12 months</button>
      <button type="button" class="range-btn" data-view="last" aria-pressed="false">Last month</button>
      <button type="button" class="range-btn" data-view="pick" aria-pressed="false">Pick month</button>
      <label class="month-pick" id="month-pick-wrap" hidden>
        <span>Month</span>
        <select id="month-pick">
          {monthOptions.map((o) => (
            <option value={o.value} selected={o.value === lastMonthValue}>{o.label}</option>
          ))}
        </select>
      </label>
    </div>
    <div
      class="area-wrap"
      id="area-wrap"
      role="img"
      aria-label={`Stacked monthly commits. Peak month ${fmt(monthMax)} commits. Total ${fmt(windowTotal)} commits over ${monthCount} months.`}
    >
      <svg
        class="area-plot"
        id="area-svg"
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
        focusable="false"
        data-weeks={JSON.stringify(weekStamps)}
      >
        {yTicks.map((t) => (
          <g class="grid">
            <line x1={PAD_L} x2={W - PAD_R} y1={t.y} y2={t.y} />
            <text x={PAD_L - 6} y={t.y + 4} text-anchor="end">{fmt(t.v)}</text>
          </g>
        ))}
        {stackedPaths.map((d, si) => (
          <path class={`area area-${si}`} data-area={series[si].id} d={d} />
        ))}
        {monthLabels.map((label, j) => (
          <text
            class="x-label"
            x={xPos(j, monthCount)}
            y={H - 8}
            text-anchor={j === 0 ? 'start' : j === monthCount - 1 ? 'end' : 'middle'}
          >{label}</text>
        ))}
      </svg>
      <div class="chart-tip" id="chart-tip" hidden></div>
    </div>
    <p class="meta y-note" id="peak-note">Peak month: {fmt(monthMax)} commits</p>
    <div class="chart-legend" id="chart-legend" role="group" aria-label="Toggle projects in chart">
      {series.map((s, si) => (
        <button
          type="button"
          class="legend-btn"
          data-legend={s.id}
          data-idx={si}
          data-n={s.windowTotal}
          data-monthly={JSON.stringify(s.monthly)}
          data-weekly={JSON.stringify(s.weekly)}
          data-projects={s.isOthers ? (s.count ?? 0) : 1}
          aria-pressed="true"
          title={`${s.title} — ${fmt(s.windowTotal)} commits in window`}
        >
          <span class={`legend-swatch seg-${si}`} aria-hidden="true" />
          <span class="legend-label">{s.title}</span>
          <span class="legend-n">{fmt(s.windowTotal)}</span>
        </button>
      ))}
    </div>
  ) : (
    <p class="meta" id="commits-total" data-total={total} data-count={sorted.length}>
      {fmt(total)} commits across {sorted.length} projects
    </p>
    <div class="chart-bars" id="chart-bars">
      {bars.map((bar) => (
        <div class="bar-row" data-bar={bar.id} data-commits={bar.commits} data-projects={bar.isOthers ? bar.count : 1}>
          <div class="bar-label">
            <span class="bar-name">{bar.title}</span>
            <span class="bar-count meta">{fmt(bar.commits)} commits</span>
          </div>
          <div class="bar-track" role="img" aria-label={`${bar.title}: ${fmt(bar.commits)} commits`}>
            <div
              class="bar-fill"
              style={`--w: ${(bar.commits / max * 100).toFixed(2)}%`}
            />
          </div>
        </div>
      ))}
    </div>
    <div class="chart-legend" id="chart-legend" role="group" aria-label="Toggle projects in chart">
      {bars.map((bar) => (
        <button
          type="button"
          class="legend-btn"
          data-legend={bar.id}
          aria-pressed="true"
          title={`${bar.title} — ${fmt(bar.commits)} commits`}
        >
          <span class="legend-swatch" aria-hidden="true" />
          <span class="legend-label">{bar.title}</span>
        </button>
      ))}
    </div>
  )}
</section>

<script is:inline define:vars={{ W, H, PAD_L, PAD_R, PAD_T, PAD_B, monthCount, monthLabels }}>
  (function () {
    var section = document.getElementById('commit-activity');
    if (!section) return;
    var totalEl = document.getElementById('commits-total');
    var legend = document.getElementById('chart-legend');
    if (!totalEl || !legend) return;

    function fmt(n) { return n.toLocaleString('en-US'); }

    function reveal() { section.classList.add('in-view'); }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { reveal(); io.disconnect(); }
        });
      }, { threshold: 0.15 });
      io.observe(section);
    } else {
      reveal();
    }

    function esc(id) {
      return (window.CSS && CSS.escape) ? CSS.escape(id) : id.replace(/["\\]/g, '');
    }

    // Stacked area mode with range views (12m / last / pick)
    var svg = document.getElementById('area-svg');
    if (svg) {
      var NS = 'http://www.w3.org/2000/svg';
      var PLOT_W = W - PAD_L - PAD_R;
      var PLOT_H = H - PAD_T - PAD_B;
      var buttons = Array.prototype.slice.call(legend.querySelectorAll('.legend-btn'));
      var rangeBtns = Array.prototype.slice.call(section.querySelectorAll('.range-btn'));
      var pickWrap = document.getElementById('month-pick-wrap');
      var pickSelect = document.getElementById('month-pick');
      var peakNote = document.getElementById('peak-note');
      var wrap = document.getElementById('area-wrap');
      var weekStamps = JSON.parse(svg.getAttribute('data-weeks') || '[]');
      var view = '12m';
      var tip = document.getElementById('chart-tip');
      var lastFrame = null;
      var SW = ['#2563eb', '#dc2626', '#16a34a', '#d97706', '#7c3aed', '#0891b2', '#db2777', '#65a30d'];

      function f(n) { return (Math.round(n * 10) / 10).toString(); }
      function xPos(j, m) {
        if (m <= 1) return PAD_L + PLOT_W / 2;
        return PAD_L + (PLOT_W * j) / (m - 1);
      }
      function yPos(v, peak) {
        if (peak <= 0) return PAD_T + PLOT_H;
        return PAD_T + PLOT_H * (1 - v / peak);
      }
      function smoothThrough(pts) {
        if (pts.length <= 1) return pts.length ? 'M ' + f(pts[0].x) + ' ' + f(pts[0].y) : '';
        if (pts.length === 2) return 'M ' + f(pts[0].x) + ' ' + f(pts[0].y) + ' L ' + f(pts[1].x) + ' ' + f(pts[1].y);
        var d = 'M ' + f(pts[0].x) + ' ' + f(pts[0].y);
        for (var i = 0; i < pts.length - 1; i++) {
          var p0 = pts[Math.max(0, i - 1)], p1 = pts[i], p2 = pts[i + 1], p3 = pts[Math.min(pts.length - 1, i + 2)];
          var c1x = p1.x + (p2.x - p0.x) / 6, c1y = p1.y + (p2.y - p0.y) / 6;
          var c2x = p2.x - (p3.x - p1.x) / 6, c2y = p2.y - (p3.y - p1.y) / 6;
          d += ' C ' + f(c1x) + ' ' + f(c1y) + ', ' + f(c2x) + ' ' + f(c2y) + ', ' + f(p2.x) + ' ' + f(p2.y);
        }
        return d;
      }
      function areaPath(top, bot) {
        if (!top.length) return '';
        if (top.length === 1) return 'M ' + f(top[0].x) + ' ' + f(top[0].y) + ' L ' + f(bot[0].x) + ' ' + f(bot[0].y) + ' Z';
        var d = smoothThrough(top);
        var rev = bot.slice().reverse();
        d += ' L ' + f(rev[0].x) + ' ' + f(rev[0].y);
        if (rev.length === 2) {
          d += ' L ' + f(rev[1].x) + ' ' + f(rev[1].y);
        } else {
          for (var i = 0; i < rev.length - 1; i++) {
            var p0 = rev[Math.max(0, i - 1)], p1 = rev[i], p2 = rev[i + 1], p3 = rev[Math.min(rev.length - 1, i + 2)];
            var c1x = p1.x + (p2.x - p0.x) / 6, c1y = p1.y + (p2.y - p0.y) / 6;
            var c2x = p2.x - (p3.x - p1.x) / 6, c2y = p2.y - (p3.y - p1.y) / 6;
            d += ' C ' + f(c1x) + ' ' + f(c1y) + ', ' + f(c2x) + ' ' + f(c2y) + ', ' + f(p2.x) + ' ' + f(p2.y);
          }
        }
        return d + ' Z';
      }
      function monthKeyOf(stamp) {
        var d = new Date(stamp * 1000);
        return d.getFullYear() * 12 + d.getMonth();
      }
      function weekLabel(stamp) {
        return new Date(stamp * 1000).toLocaleString('en-US', { month: 'short', day: 'numeric' });
      }
      function keyOfValue(val) {
        var parts = String(val).split('-');
        return parseInt(parts[0], 10) * 12 + (parseInt(parts[1], 10) - 1);
      }

      function currentFrame() {
        var monthlyMode = view === '12m';
        var targetKey;
        if (view === 'last') {
          targetKey = -Infinity;
          weekStamps.forEach(function (s) { targetKey = Math.max(targetKey, monthKeyOf(s)); });
        } else if (view === 'pick' && pickSelect) {
          targetKey = keyOfValue(pickSelect.value);
        }
        var labels, idx;
        if (monthlyMode) {
          labels = monthLabels.slice();
          idx = null;
        } else {
          idx = [];
          labels = [];
          weekStamps.forEach(function (s, j) {
            if (monthKeyOf(s) === targetKey) { idx.push(j); labels.push(weekLabel(s)); }
          });
        }
        var cols = buttons.map(function (b) {
          var full = monthlyMode
            ? JSON.parse(b.getAttribute('data-monthly') || '[]')
            : JSON.parse(b.getAttribute('data-weekly') || '[]');
          var arr = monthlyMode ? full.slice() : idx.map(function (j) { return full[j] || 0; });
          return { id: b.getAttribute('data-legend'), arr: arr, btn: b };
        });
        return { labels: labels, cols: cols, monthlyMode: monthlyMode };
      }

      function render() {
        var frame = currentFrame();
        var m = frame.monthlyMode ? monthCount : frame.labels.length;
        if (!m) return;
        hideTip();
        // Per-series view totals -> badges + data-n
        frame.cols.forEach(function (c) {
          var t = c.arr.reduce(function (a, b) { return a + b; }, 0);
          c.btn.setAttribute('data-n', String(t));
          var badge = c.btn.querySelector('.legend-n');
          if (badge) badge.textContent = fmt(t);
          c.btn.title = c.btn.querySelector('.legend-label').textContent + ' — ' + fmt(t) + ' commits in view';
        });
        var visible = frame.cols.filter(function (c) { return c.btn.getAttribute('aria-pressed') === 'true'; });
        var totals = new Array(m).fill(0);
        visible.forEach(function (c) {
          for (var j = 0; j < m; j++) totals[j] += c.arr[j] || 0;
        });
        var peak = Math.max.apply(null, totals.concat([1]));
        // Rebuild SVG: grid + areas + x labels
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        var tickVals = [0, Math.ceil(peak / 3), Math.ceil((2 * peak) / 3), peak];
        var uniq = Array.from(new Set(tickVals)).sort(function (a, b) { return a - b; });
        uniq.forEach(function (v) {
          var g = document.createElementNS(NS, 'g');
          g.setAttribute('class', 'grid');
          var line = document.createElementNS(NS, 'line');
          line.setAttribute('x1', PAD_L); line.setAttribute('x2', W - PAD_R);
          var y = yPos(v, peak);
          line.setAttribute('y1', y); line.setAttribute('y2', y);
          var tx = document.createElementNS(NS, 'text');
          tx.setAttribute('x', PAD_L - 6); tx.setAttribute('y', y + 4);
          tx.setAttribute('text-anchor', 'end');
          tx.textContent = fmt(v);
          g.appendChild(line); g.appendChild(tx);
          svg.appendChild(g);
        });
        var cum = new Array(m).fill(0);
        visible.forEach(function (c) {
          var idx = c.btn.getAttribute('data-idx') || '0';
          var top = [], bot = [];
          for (var j = 0; j < m; j++) {
            var y0 = cum[j], y1 = cum[j] + (c.arr[j] || 0);
            bot.push({ x: xPos(j, m), y: yPos(y0, peak) });
            top.push({ x: xPos(j, m), y: yPos(y1, peak) });
            cum[j] = y1;
          }
          var path = document.createElementNS(NS, 'path');
          path.setAttribute('class', 'area area-' + idx);
          path.setAttribute('data-area', c.id);
          path.setAttribute('d', areaPath(top, bot));
          svg.appendChild(path);
        });
        frame.labels.forEach(function (label, j) {
          var tx = document.createElementNS(NS, 'text');
          tx.setAttribute('class', 'x-label');
          tx.setAttribute('x', xPos(j, m));
          tx.setAttribute('y', H - 8);
          tx.setAttribute('text-anchor', j === 0 ? 'start' : j === m - 1 ? 'end' : 'middle');
          tx.textContent = label;
          svg.appendChild(tx);
        });
        // Totals + peak + aria
        var sum = 0, projectCount = 0;
        visible.forEach(function (c) {
          sum += c.arr.reduce(function (a, b) { return a + b; }, 0);
          projectCount += parseInt(c.btn.getAttribute('data-projects') || '1', 10);
        });
        var rangeText;
        if (frame.monthlyMode) {
          rangeText = 'in the last ' + monthCount + ' months';
        } else {
          var opt = pickSelect && pickSelect.selectedOptions.length
            ? pickSelect.selectedOptions[0].textContent
            : weekLabel(weekStamps[weekStamps.length - 1]);
          rangeText = 'in ' + opt + ' (' + m + (m === 1 ? ' week)' : ' weeks)');
        }
        if (sum === 0) {
          totalEl.textContent = 'All hidden — toggle a project to show commits';
        } else {
          totalEl.textContent = fmt(sum) + ' commits ' + rangeText + ' across ' + fmt(projectCount) + ' projects';
        }
        if (peakNote) {
          peakNote.textContent = frame.monthlyMode
            ? 'Peak month: ' + fmt(peak) + ' commits'
            : 'Peak week: ' + fmt(peak) + ' commits';
        }
        if (wrap) {
          wrap.setAttribute('aria-label', 'Stacked commits ' + rangeText + '. Peak ' + fmt(peak) + ' commits. Total ' + fmt(sum) + ' commits.');
        }
        storeFrame(frame, visible, m);
      }

      // Hover tooltip: per-project breakdown at nearest point
      function escHtml(s) {
        return String(s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function swColor(idx) { return idx >= 0 && idx < 8 ? SW[idx] : 'var(--muted)'; }
      function hideTip() { if (tip) tip.hidden = true; }
      function storeFrame(frame, visible, m) {
        lastFrame = {
          labels: frame.labels.slice(),
          m: m,
          rows: visible.map(function (c) {
            var lbl = c.btn.querySelector('.legend-label');
            return {
              title: lbl ? lbl.textContent : c.id,
              idx: parseInt(c.btn.getAttribute('data-idx') || '0', 10),
              arr: c.arr.slice()
            };
          })
        };
      }
      function showTip(j) {
        if (!tip || !lastFrame) return false;
        var m = lastFrame.m, labels = lastFrame.labels;
        if (!m || j < 0 || j >= m) return false;
        var total = 0, rowsHtml = '';
        lastFrame.rows.forEach(function (r) {
          var n = r.arr[j] || 0;
          total += n;
          if (n > 0) {
            rowsHtml += '<div class="tip-row"><span class="tip-swatch" style="background:' + swColor(r.idx) + '"></span>' +
              '<span class="tip-name">' + escHtml(r.title) + '</span>' +
              '<span class="tip-val">' + fmt(n) + '</span></div>';
          }
        });
        tip.innerHTML = '<div class="tip-head">' + escHtml(labels[j]) + ' · ' + fmt(total) + '</div>' +
          (rowsHtml || '<div class="tip-row tip-empty">No commits</div>');
        tip.hidden = false;
        return true;
      }
      function placeTip(clientX, clientY) {
        if (!tip || !wrap) return;
        var wr = wrap.getBoundingClientRect();
        var tw = tip.offsetWidth, th = tip.offsetHeight;
        var x = clientX - wr.left, y = clientY - wr.top;
        var left = x + 14, top = y - th - 14;
        if (left + tw > wr.width - 8) left = x - tw - 14;
        if (left < 8) left = 8;
        if (top < 8) top = 8;
        if (top + th > wr.height - 8) top = Math.max(8, wr.height - th - 8);
        tip.style.left = left + 'px';
        tip.style.top = top + 'px';
      }
      function pointFromEvent(e) {
        if (!lastFrame || !lastFrame.m) return -1;
        var m = lastFrame.m;
        if (m <= 1) return 0;
        var r = svg.getBoundingClientRect();
        var px = (e.clientX - r.left) * (W / r.width);
        return Math.max(0, Math.min(m - 1, Math.round((px - PAD_L) / (PLOT_W / (m - 1)))));
      }
      function hoverAt(e) {
        var j = pointFromEvent(e);
        if (j < 0 || !showTip(j)) return;
        placeTip(e.clientX, e.clientY);
      }
      svg.addEventListener('mousemove', hoverAt);
      svg.addEventListener('click', hoverAt);
      svg.addEventListener('mouseleave', hideTip);
      // Snapshot server-rendered 12m view so hover works before any switch
      (function () {
        var frame = currentFrame();
        var m = frame.monthlyMode ? monthCount : frame.labels.length;
        if (!m) return;
        var visible = frame.cols.filter(function (c) { return c.btn.getAttribute('aria-pressed') === 'true'; });
        storeFrame(frame, visible, m);
      })();

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var on = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', on ? 'false' : 'true');
          render();
        });
      });
      rangeBtns.forEach(function (rb) {
        rb.addEventListener('click', function () {
          view = rb.getAttribute('data-view');
          rangeBtns.forEach(function (o) {
            o.setAttribute('aria-pressed', o === rb ? 'true' : 'false');
          });
          if (pickWrap) pickWrap.hidden = view !== 'pick';
          render();
        });
      });
      if (pickSelect) {
        pickSelect.addEventListener('change', function () {
          if (view !== 'pick') {
            view = 'pick';
            rangeBtns.forEach(function (o) {
              o.setAttribute('aria-pressed', o.getAttribute('data-view') === 'pick' ? 'true' : 'false');
            });
            if (pickWrap) pickWrap.hidden = false;
          }
          render();
        });
      }
      return;
    }

    // Snapshot mode: toggle bars
    var barsEl = document.getElementById('chart-bars');
    if (!barsEl) return;
    var rows = Array.prototype.slice.call(barsEl.querySelectorAll('.bar-row'));
    var snapBtns = Array.prototype.slice.call(legend.querySelectorAll('.legend-btn'));
    snapBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = btn.getAttribute('data-legend');
        var on = btn.getAttribute('aria-pressed') === 'true';
        btn.setAttribute('aria-pressed', on ? 'false' : 'true');
        var row = barsEl.querySelector('[data-bar="' + esc(id) + '"]');
        if (row) row.hidden = on;
        var sum = 0, projectCount = 0;
        rows.forEach(function (r) {
          if (!r.hidden) {
            sum += parseInt(r.getAttribute('data-commits') || '0', 10);
            projectCount += parseInt(r.getAttribute('data-projects') || '1', 10);
          }
        });
        if (sum === 0) {
          totalEl.textContent = 'All hidden — toggle a project to show commits';
        } else {
          totalEl.textContent = fmt(sum) + ' commits across ' + fmt(projectCount) + ' projects';
        }
      });
    });
  })();
</script>

<style>
