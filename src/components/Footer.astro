---
import { SITE, SOCIAL_LINKS } from '../lib/constants';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const posts = await getCollection('blog');
const photos = await getCollection('photos');
const finds = await getCollection('finds');
---

<footer class="site-footer">
  <div class="wrap">
    <p>Kathmandu, Nepal — {SITE.author}</p>
    <p class="social-row">
      {SOCIAL_LINKS.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer">{link.title}</a>
      ))}
    </p>
    <p class="meta">
      {projects.length} projects · {posts.length} blogs · {photos.length} photos · {finds.length} finds · © {SITE.author} {new Date().getFullYear()}
    </p>
    <p class="meta">
      <a href="/rss.xml">RSS</a> · <a href="/sitemap-index.xml">Sitemap</a>
    </p>
  </div>
</footer>
