---
import BaseLayout from './BaseLayout.astro';
import { formatDate, person } from '../lib/utils';
import { SITE, DISQUS_SHORTNAME } from '../lib/constants';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
}

const { title, description, date, tags } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  author: person(SITE.author, SITE.siteUrl),
  publisher: person(SITE.author),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${SITE.siteUrl}${Astro.url.pathname}`,
  },
};
---

<BaseLayout title={`${title} | ${SITE.title}`} description={description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <p><a href="/blog">← Back to blog</a></p>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {` — ${tags.join(', ')}`}
    </p>
    <div class="prose">
      <slot />
    </div>
    <footer>
      <hr />
      <h2>Comments</h2>
        <div id="disqus_thread" data-shortname={DISQUS_SHORTNAME}></div>
        <script is:inline>
          (function () {
            var thread = document.getElementById('disqus_thread');
            if (!thread) return;
            function load() {
              var s = document.createElement('script');
              s.src = 'https://' + thread.getAttribute('data-shortname') + '.disqus.com/embed.js';
              s.async = true;
              s.setAttribute('data-timestamp', Date.now());
              document.body.appendChild(s);
            }
            if ('IntersectionObserver' in window) {
              var obs = new IntersectionObserver(function (entries) {
                if (entries[0].isIntersecting) { obs.disconnect(); load(); }
              }, { rootMargin: '400px' });
              obs.observe(thread);
            } else { load(); }
          })();
        </script>
      <noscript>Please enable JavaScript to view comments.</noscript>
    </footer>
  </article>
</BaseLayout>
