---
import BaseLayout from './BaseLayout.astro';
import { formatDate, person } from '../lib/utils';
import { SITE } from '../lib/constants';
import Comments from '../components/Comments.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
}

const { title, description, date, updated, tags } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: person(SITE.author, SITE.siteUrl),
  publisher: person(SITE.author),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${SITE.siteUrl}${Astro.url.pathname}`,
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<BaseLayout title={title} description={description} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <article>
    <p><a href="/blog/">← Back to blog</a></p>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {` — ${tags.join(', ')}`}
    </p>
    <div class="prose">
      <slot />
    </div>
    <footer>
      <Comments />
    </footer>
  </article>
</BaseLayout>
