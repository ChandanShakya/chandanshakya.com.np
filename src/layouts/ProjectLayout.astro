---
import BaseLayout from './BaseLayout.astro';
import { formatDate, person } from '../lib/utils';
import { SITE } from '../lib/constants';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  link: string;
  client: string;
  commits?: number;
}

const { title, description, date, category, link, client, commits = 0 } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: description,
  dateCreated: date.toISOString(),
  applicationCategory: category,
  author: person(SITE.author, SITE.siteUrl),
  url: link || `${SITE.siteUrl}${Astro.url.pathname}`,
};
---

<BaseLayout title={`${title} | ${SITE.title}`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article>
    <p><a href="/projects">← Back to projects</a></p>
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {` — ${category}`}
      {client !== 'Public' ? ` — Client: ${client}` : ''}
      {commits > 0 ? ` — ★ ${commits.toLocaleString()}` : ''}
    </p>
    <div class="prose">
      <p>{description}</p>
    </div>
    {link && (
      <p><a class="btn" href={link} target="_blank" rel="noopener noreferrer">View on GitHub →</a></p>
    )}
  </article>
</BaseLayout>
