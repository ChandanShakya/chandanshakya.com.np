---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/constants';
import { sortDesc } from '../../lib/utils';

const projects = sortDesc(await getCollection('projects'), (p) => p.data.commits || 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Projects | ${SITE.title}`,
  url: `${SITE.siteUrl}/projects`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: projects.map((project, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.siteUrl}/projects/${project.id}`,
      name: project.data.title,
    })),
  },
};

const categories = [...new Set(
  projects.map((p) => p.data.category.split(',')[0].trim())
)].sort();
---

<BaseLayout title="Projects" description={`Projects by ${SITE.author}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <h1>Projects</h1>
  <p class="meta">{projects.length} projects across {categories.length} categories</p>

  <div class="filter-row" id="filter-tabs" role="group" aria-label="Filter projects by category">
    <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">All</button>
    {categories.map((cat) => (
      <button type="button" class="filter-btn" data-filter={cat} aria-pressed="false">{cat}</button>
    ))}
  </div>

  <ul class="plain" id="projects-list">
    {projects.map((project) => (
      <li data-categories={project.data.category}>
        <a href={`/projects/${project.id}`}>{project.data.title}</a>
        <span class="meta">
          {' '}— {project.data.category}
          {(project.data.commits || 0) > 0 ? ` (★ ${project.data.commits.toLocaleString()})` : ''}
        </span>
      </li>
    ))}
  </ul>

  <p id="no-results" class="meta" hidden>No projects found in this category.</p>

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('#filter-tabs .filter-btn');
      var items = document.querySelectorAll('#projects-list > li');
      var noResults = document.getElementById('no-results');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var filter = tab.getAttribute('data-filter') || 'all';
          tabs.forEach(function (t) {
            t.setAttribute('aria-pressed', t === tab ? 'true' : 'false');
          });
          var visible = 0;
          items.forEach(function (item) {
            var cats = (item.getAttribute('data-categories') || '').toLowerCase();
            var show = filter === 'all' || cats.indexOf(filter.toLowerCase()) !== -1;
            item.hidden = !show;
            if (show) visible++;
          });
          noResults.hidden = visible > 0;
        });
      });
    })();
  </script>
</BaseLayout>
