---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, sortDesc } from '../lib/utils';
import { SITE } from '../lib/constants';

const blogPosts = sortDesc(await getCollection('blog'), (p) => p.data.date.valueOf());
const projects = sortDesc(await getCollection('projects'), (p) => p.data.date.valueOf());

const byYear = <T extends { data: { date: Date } }>(items: T[]) => {
  const groups: Record<string, T[]> = {};
  for (const item of items) (groups[item.data.date.getFullYear()] ??= []).push(item);
  return groups;
};
const blogByYear = byYear(blogPosts);
const projectsByYear = byYear(projects);

const years = [...new Set([...Object.keys(blogByYear), ...Object.keys(projectsByYear)])].sort().reverse();
---

<BaseLayout title="Archive" description={`Archive of all posts and projects by ${SITE.author}`}>
  <h1>Archive</h1>
  {years.map((year, i) => (
    <section>
      {i > 0 && <hr />}
      <h2>{year}</h2>
      {[
        { label: 'Blog posts', base: 'blog', items: blogByYear[year] },
        { label: 'Projects', base: 'projects', items: projectsByYear[year] },
      ].filter((s) => s.items).map((s) => (
        <>
          <h3>{s.label}</h3>
          <ul class="plain">
            {s.items.map((item) => (
              <li>
                <a href={`/${s.base}/${item.id}`}>{item.data.title}</a>
                {' '}<span class="meta">{formatDate(item.data.date)}</span>
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>
  ))}
</BaseLayout>
