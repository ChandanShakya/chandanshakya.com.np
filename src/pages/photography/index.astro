---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { Picture, Image } from 'astro:assets';
import { SITE } from '../../lib/constants';

const devices = await getCollection('devices');
// Manual `order` first (ascending), everything else after it, newest first.
const rank = (p: { data: { order?: number } }) => p.data.order ?? Infinity;
const photos = (await getCollection('photos')).sort(
  (a, b) =>
    (rank(a) === rank(b) ? 0 : rank(a) < rank(b) ? -1 : 1) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const photoCount = photos.filter((p) => p.data.kind === 'photo').length;
const artCount = photos.filter((p) => p.data.kind === 'digital-art').length;

const deviceFilters = devices.map((device) => ({
  id: device.id,
  name: device.data.name,
  image: device.data.image,
  count: photos.filter((p) => p.data.device === device.id).length,
}));
const deviceById = new Map(deviceFilters.map((d) => [d.id, d]));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Photography | ${SITE.title}`,
  url: `${SITE.siteUrl}/photography/`,
  author: { '@type': 'Person', name: SITE.author, url: `${SITE.siteUrl}/` },
};
---

<BaseLayout
  title="Photography"
  description="Photography and digital art by Chandan Shakya, shot on a Samsung Galaxy S23 Ultra and created with digital tools."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <PageHead
    title="Photography"
    meta={`${photos.length} ${photos.length === 1 ? 'item' : 'items'} · ${devices.length} ${devices.length === 1 ? 'device' : 'devices'}`}
  />

  <div class="toolbar">
    <div class="seg" role="group" aria-label="Filter by kind">
      <button type="button" class="filter-btn" data-kind-filter="all" aria-pressed="true">
        All <span class="count">{photos.length}</span>
      </button>
      <button type="button" class="filter-btn" data-kind-filter="photo" aria-pressed="false">
        Photos <span class="count">{photoCount}</span>
      </button>
      <button type="button" class="filter-btn" data-kind-filter="digital-art" aria-pressed="false">
        Art <span class="count">{artCount}</span>
      </button>
    </div>

    {deviceFilters.length > 1 && (
      <label class="shot-on">
        Shot on
        <select id="device-select" aria-label="Filter by device">
          <option value="all">All devices ({photos.length})</option>
          {deviceFilters.map((device) => (
            <option value={device.id}>{device.name} ({device.count})</option>
          ))}
        </select>
      </label>
    )}
  </div>

  {photos.length === 0 && (
    <p class="empty-state" id="empty-all">No photos yet.</p>
  )}

  <ul class="photo-grid" id="photo-grid">
    {photos.map((photo, index) => (
      <li
        class="photo-card"
        data-kind={photo.data.kind}
        data-device={photo.data.device}
        style={`--r: ${(photo.data.image.width / photo.data.image.height).toFixed(4)}`}
      >
        <a class="photo-link" href={`/photography/${photo.id}/`} aria-label={photo.data.title}>
        <figure>
          <Picture
            src={photo.data.image}
            formats={['webp', 'jpeg']}
            widths={[400, 800, 1200, 1600]}
            quality={80}
            sizes="(min-width: 720px) 400px, 100vw"
            alt={photo.data.title}
            loading={index < 2 ? 'eager' : 'lazy'}
            fetchpriority={index < 2 ? 'high' : undefined}
            decoding="async"
            style={`aspect-ratio: ${photo.data.image.width} / ${photo.data.image.height};`}
          />
          <figcaption>
            <strong>{photo.data.title}</strong>
            <span class="meta">
              {deviceById.get(photo.data.device)?.image && (
                <Image
                  src={deviceById.get(photo.data.device)!.image!}
                  width={32}
                  height={32}
                  formats={['webp', 'jpeg']}
                  quality={80}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="avatar"
                />
              )}
              <span>{deviceById.get(photo.data.device)?.name ?? photo.data.device}</span>
              {photo.data.location && <span>{photo.data.location}</span>}
              <span><time datetime={photo.data.date.toISOString()}>{photo.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></span>
            </span>
            {photo.data.caption && <span class="caption">{photo.data.caption}</span>}
          </figcaption>
        </figure>
        </a>
      </li>
    ))}
  </ul>

  <p class="empty-state" id="empty-filtered" hidden>No photos match these filters.</p>
  <div id="scroll-sentinel" class="sentinel" aria-hidden="true"></div>

  <script is:inline>
    (function () {
      var grid = document.getElementById('photo-grid');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.photo-card'));
      var sentinel = document.getElementById('scroll-sentinel');
      var emptyFiltered = document.getElementById('empty-filtered');
      var emptyAll = document.getElementById('empty-all');
      var PAGE_SIZE = 12;
      var kindFilter = 'all';
      var deviceFilter = 'all';
      var visibleCount = PAGE_SIZE;

      function matches(card) {
        var kind = card.getAttribute('data-kind');
        var device = card.getAttribute('data-device');
        var kindOk = kindFilter === 'all' || kind === kindFilter;
        var deviceOk = deviceFilter === 'all' || device === deviceFilter;
        return kindOk && deviceOk;
      }

      function apply() {
        var filtered = cards.filter(matches);
        var shown = 0;
        cards.forEach(function (card) {
          if (!matches(card)) {
            card.hidden = true;
            return;
          }
          if (shown < visibleCount) {
            card.hidden = false;
            shown += 1;
          } else {
            card.hidden = true;
          }
        });
        if (emptyFiltered) {
          emptyFiltered.hidden = !(filtered.length === 0 && cards.length > 0);
        }
        if (emptyAll) {
          emptyAll.hidden = cards.length !== 0;
        }
        if (sentinel) {
          sentinel.hidden = filtered.length <= visibleCount;
        }
      }

      function resetAndApply() {
        visibleCount = PAGE_SIZE;
        apply();
      }

      function setPressed(selector, value) {
        document.querySelectorAll(selector).forEach(function (btn) {
          btn.setAttribute('aria-pressed', btn.getAttribute('data-kind-filter') === value ? 'true' : 'false');
        });
      }

      document.querySelectorAll('[data-kind-filter]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          kindFilter = btn.getAttribute('data-kind-filter') || 'all';
          setPressed('[data-kind-filter]', kindFilter);
          resetAndApply();
        });
      });

      var deviceSelect = document.getElementById('device-select');
      if (deviceSelect) {
        deviceSelect.addEventListener('change', function () {
          deviceFilter = deviceSelect.value || 'all';
          resetAndApply();
        });
      }

      if (sentinel && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var filteredCount = cards.filter(matches).length;
            if (visibleCount >= filteredCount) return;
            visibleCount = Math.min(visibleCount + PAGE_SIZE, filteredCount);
            apply();
          });
        }, { rootMargin: '300px 0px' });
        io.observe(sentinel);
      }

      apply();
    })();
  </script>

  <style>
    /* Justified rows: each item's width is proportional to its aspect ratio (--r),
       so every photo in a row gets the same height and rows fill the full width. */
    .photo-grid {
      list-style: none;
      padding: 0;
      margin: 1rem 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    /* Stops the last row from stretching a lone photo to full width. */
    .photo-grid::after { content: ''; flex-grow: 1000000; }
    .photo-card {
      flex: var(--r) 1 calc(var(--r) * 12rem);
      min-width: 0;
    }
    .photo-card[hidden] { display: none; }
    .photo-link { display: block; color: inherit; text-decoration: none; }
    .photo-card figure {
      position: relative;
      margin: 0;
      border: var(--border-width) solid var(--border);
      box-shadow: var(--shadow);
      background: var(--code-bg);
      overflow: hidden;
    }
    .photo-card img { display: block; width: 100%; height: auto; }
    .photo-card figcaption {
      position: absolute;
      inset: auto 0 0 0;
      padding: 1.5rem 0.5rem 0.4rem;
      font-size: 0.7rem;
      line-height: 1.3;
      color: #fff;
      background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
      pointer-events: none;
    }
    .photo-card figcaption strong {
      display: block;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      font-size: 0.75rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .photo-card .meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.25rem;
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.7rem;
    }
    /* Long caption text only on hover / keyboard focus, so rows stay clean. */
    .caption { display: none; margin-top: 0.2rem; }
    .photo-card figure:hover .caption,
    .photo-card figure:focus-within .caption { display: block; }
    .empty-state { color: var(--muted); }
    .shot-on { display: flex; align-items: center; gap: 0.4rem; margin: 0; font-size: 0.75rem; font-weight: 400; color: var(--muted); }
    .shot-on select { font: inherit; font-size: 0.75rem; color: var(--fg); background: var(--bg); border: 2px solid var(--border); padding: 0.1rem 0.3rem; border-radius: 0; }
    .toolbar { justify-content: space-between; }
    .photo-card .avatar {
      width: 1rem;
      height: 1rem;
      object-fit: cover;
      border-radius: 50%;
      flex: none;
    }
    .sentinel { height: 1px; }
    .sentinel[hidden] { display: none; }
    .photo-card .meta { column-gap: 0.6rem; row-gap: 0.15rem; }
    .photo-card .meta > span { white-space: nowrap; }
    @media (max-width: 560px) {
      .photo-card figcaption strong { white-space: normal; overflow: visible; text-overflow: clip; }
    }
    @media (hover: none) {
      .caption { display: block; }
    }
  </style>
</BaseLayout>
