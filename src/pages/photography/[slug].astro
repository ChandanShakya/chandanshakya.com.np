---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { SITE } from '../../lib/constants';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map((photo) => ({ params: { slug: photo.id }, props: { photo } }));
}

const { photo } = Astro.props;
const { title, image, device, kind, location, caption, date } = photo.data;
const { Content } = await render(photo);
const deviceName = (await getCollection('devices')).find((d) => d.id === device)?.data.name ?? device;
const description = caption ?? `${title}${location ? ` — ${location}` : ''}, ${kind === 'photo' ? 'shot' : 'made'} on ${deviceName}.`;
const url = `${SITE.siteUrl}/photography/${photo.id}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: title,
  description,
  datePublished: date.toISOString(),
  contentLocation: location,
  author: { '@type': 'Person', name: SITE.author, url: `${SITE.siteUrl}/` },
  mainEntityOfPage: url,
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Photography', item: `${SITE.siteUrl}/photography/` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <article>
    <p><a href="/photography/">← Back to photos</a></p>
    <h1>{title}</h1>
    <p class="meta">
      {deviceName} · {location ? `${location} · ` : ''}<time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <figure class="shot">
      <Picture
        src={image}
        formats={['webp', 'jpeg']}
        widths={[640, 960, 1280, 1920]}
        quality={82}
        sizes="(min-width: 704px) 704px, 100vw"
        alt={title}
        loading="eager"
        fetchpriority="high"
        style={`aspect-ratio: ${image.width} / ${image.height};`}
      />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
    <div class="prose"><Content /></div>
    <footer><Comments /></footer>
  </article>

  <style>
    .shot { margin: 1rem 0; }
    .shot img { display: block; width: 100%; height: auto; border: var(--border-width) solid var(--border); box-shadow: var(--shadow); background: var(--code-bg); }
    .shot figcaption { margin-top: 0.6rem; color: var(--muted); font-size: 0.95rem; }
  </style>
</BaseLayout>
